# ── Inference stack environment — copy to .env and fill in values ────────────
# Never commit the actual .env file.

# Model selection (Ollama target)
MODEL_NAME=qwen2.5:7b
# For production large-parameter deployment:
# MODEL_NAME=qwen2.5:235b-a22b-q4_K_M

# vLLM target
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FastAPI security gateway
JWT_SECRET=change-me-to-a-256-bit-secret
JWT_ALGORITHM=HS256
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024

# Redis
REDIS_URL=redis://redis:6379/0
PII_TOKEN_TTL_SECONDS=3600

# Observability
GRAFANA_PASSWORD=changeme
LOG_LEVEL=INFO

# Audit
AUDIT_LOG_DB=/data/audit_log.db
